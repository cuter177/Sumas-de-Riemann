<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.web.WebView?>

<BorderPane prefWidth="640.0" prefHeight="560.0" minWidth="460.0" minHeight="420.0" stylesheets="@/css/styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.InterfazController">
   <top>
      <VBox fx:id="barraSuperior" spacing="8.0">
         <padding>
            <Insets bottom="4.0" left="14.0" right="14.0" top="10.0" />
         </padding>
         <children>
            <HBox fx:id="tituloBar" alignment="CENTER_LEFT" spacing="8.0">
               <children>
                  <Label text="Sumas de Riemann">
                     <font>
                        <Font size="24.0" />
                     </font>
                  </Label>
                  <Region HBox.hgrow="ALWAYS" />
                  <Button fx:id="btnMinimizar" mnemonicParsing="false" onAction="#Salir" styleClass="btn-minimizar" text="—" />
                  <Button fx:id="btnCerrar" mnemonicParsing="false" onAction="#Cerrar" styleClass="btn-cerrar" text="✕" />
               </children>
            </HBox>
            <TextField fx:id="txtFuncion" maxWidth="Infinity" prefHeight="28.0" promptText="Ingresar función " />
            <HBox spacing="11.0">
               <children>
                  <TextField fx:id="txtLi" maxWidth="Infinity" promptText="Límite inferior" HBox.hgrow="ALWAYS" />
                  <TextField fx:id="txtLs" maxWidth="Infinity" promptText="Límite superior" HBox.hgrow="ALWAYS" />
                  <TextField fx:id="txtN" maxWidth="Infinity" promptText="Número de rectángulos" HBox.hgrow="ALWAYS" />
               </children>
            </HBox>
         </children>
      </VBox>
   </top>
   <center>
      <AnchorPane fx:id="visorLatex" minHeight="140.0">
         <BorderPane.margin>
            <Insets bottom="4.0" left="14.0" right="14.0" top="4.0" />
         </BorderPane.margin>
         <children>
            <WebView fx:id="webViewLatex" />
         </children>
      </AnchorPane>
   </center>
   <bottom>
      <VBox alignment="CENTER" spacing="6.0">
         <padding>
            <Insets bottom="12.0" left="14.0" right="14.0" top="6.0" />
         </padding>
         <children>
            <Button fx:id="btnCalcular" mnemonicParsing="false" onAction="#guardarJson" styleClass="btn-calcular" text="Calcular" />
            <Label fx:id="lblSuma" maxWidth="Infinity" wrapText="true" />
            <Label fx:id="lblDeltax" maxWidth="Infinity" wrapText="true" />
         </children>
      </VBox>
   </bottom>
</BorderPane>
